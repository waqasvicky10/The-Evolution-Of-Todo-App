# ===========================================
# Heckathon-3 — Environment Template
# Copy to .env and fill in values
# ===========================================

# Backend (required)
DATABASE_URL=sqlite:///./todo.db
SECRET_KEY=your-secret-key-at-least-32-characters-long

# AI (optional, mock works without key)
MOCK_MODE=true
OPENAI_API_KEY=mock

# Frontend — leave NEXT_PUBLIC_API_BASE_URL empty for proxy (no CORS)
# Only set if you want direct backend calls
NEXT_PUBLIC_API_BASE_URL=
